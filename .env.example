# Study AI Teaching SaaS production environment template
# 复制为 .env 后按服务器域名/IP修改。

# 浏览器访问后端的公网地址。生产建议填 https://api.example.com
PUBLIC_API_BASE_URL=http://127.0.0.1:18080

# 容器端口映射
BACKEND_PORT=18080
# 统一 Web 前端（admin / teacher / student）
WEB_PORT=18081
# 兼容旧变量名
TEACHER_PORT=18081

# CORS 白名单。生产必须改成真实前端域名。
EDU_ALLOWED_ORIGINS=http://127.0.0.1:18081,http://localhost:18081

# 云雀 / DeepSeek 等 OpenAI 兼容网关
YUNQUE_BASE_URL=https://api.deepseek.com
YUNQUE_API_KEY=

# PostgreSQL migration target（可选；当前默认 SQLite）
POSTGRES_DB=study
POSTGRES_USER=study
POSTGRES_PASSWORD=study123456
POSTGRES_PORT=15432
EDU_STORAGE_DRIVER=sqlite
DATABASE_URL=postgres://study:study123456@127.0.0.1:15432/study?sslmode=disable
EDU_SQLITE_PATH=./backend/data/study.db
